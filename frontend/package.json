{
  "name": "wattpilot-dashboard-cards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lovelace dashboard cards for the Fronius Wattpilot Home Assistant integration",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",

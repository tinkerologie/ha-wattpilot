#!/bin/bash

# scripts/hassfest: Run Home Assistant hassfest validation
#
# Validates the integration against Home Assistant's official validation rules
# using hassfest from the Home Assistant Core repository.
#
# On first run, clones HA Core (~27 MB) to .local/ha-core
# Subsequent runs reuse the cached version (use --update to force an update).
#
# Usage:
#   ./scripts/hassfest [options]
#
# Options:
#   --update             Force update HA Core to match installed version
#   --skip-plugins LIST  Comma-separated list of plugins to skip
#                        Default: quality_scale,requirements
#
# HA_VERSION selects the Core revision: a release tag (2026.11.0b0), "dev", or a
# full 40-character commit SHA (as the HA Next workflow passes for Core dev).
# Without it, the version of the installed homeassistant package is used.
#
# Examples:
#   ./scripts/hassfest               # Use cached version (fast)
#   ./scripts/hassfest --update      # Update to match HA version

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

log_header() { printf '\n==> %s\n' "$1"; }
log_info() { printf '%s\n' "$1"; }
log_success() { printf 'OK: %s\n' "$1"; }
log_error() { printf 'ERROR: %s\n' "$1" >&2; }

# Configuration
HA_CORE_DIR=".local/ha-core"
HA_CORE_REPO="${HA_CORE_REPO:-https://github.com/home-assistant/core.git}"
INTEGRATION_PATH="custom_components/wattpilot"

# Activate virtual environment before resolving the target Home Assistant version.
if [[ -z ${VIRTUAL_ENV:-} ]]; then
    if [[ -f "$PWD/.venv/bin/activate" ]]; then
        # shellcheck source=/dev/null
        source "$PWD/.venv/bin/activate"
    else
        log_error "Virtual environment not found"
        log_info "Run: uv sync --group dev"
        exit 1
    fi
fi

# Detect Home Assistant version to use
if [ -n "${HA_VERSION:-}" ]; then
    # Use version from environment (DevContainer, HA Next workflow)
    HA_VERSION_TAG="$HA_VERSION"
elif command -v python3 >/dev/null 2>&1; then
    # Detect from installed homeassistant package
    HA_VERSION_TAG=$(python3 -c "from homeassistant.const import __version__; print(__version__)" 2>/dev/null || echo "dev")
else
    # Fallback to dev branch
    HA_VERSION_TAG="dev"
fi

# Parse arguments
UPDATE_CORE=false  # Default to no update for speed
SKIP_PLUGINS="quality_scale,requirements"

while [[ $# -gt 0 ]]; do
    case $1 in
        --update)
            UPDATE_CORE=true
            shift
            ;;
        --skip-plugins)
            SKIP_PLUGINS="$2"
            shift 2
            ;;
        *)
            # Pass unknown args to hassfest
            break
            ;;
    esac
done

log_header "Home Assistant hassfest validation"
log_info "Target version: $HA_VERSION_TAG"

is_commit_sha() {
    [[ "$1" =~ ^[0-9a-f]{40}$ ]]
}

# Fetch and check out the selected Core revision (run inside $HA_CORE_DIR).
checkout_core_revision() {
    if [ "$HA_VERSION_TAG" = "dev" ]; then
        git fetch --depth 1 --filter=blob:none origin dev 2>&1 | grep -E "(Receiving|Resolving|Fetching)" || true
        # -B moves a cached dev branch to the fetched commit, so --update refreshes it.
        git checkout -B dev FETCH_HEAD >/dev/null 2>&1
    elif is_commit_sha "$HA_VERSION_TAG"; then
        git fetch --depth 1 --filter=blob:none origin "$HA_VERSION_TAG" 2>&1 | grep -E "(Receiving|Resolving|Fetching)" || true
        git checkout --detach FETCH_HEAD >/dev/null 2>&1
    else
        git fetch --depth 1 --filter=blob:none origin tag "$HA_VERSION_TAG" 2>&1 | grep -E "(Receiving|Resolving|Fetching)" || true
        git checkout "$HA_VERSION_TAG" >/dev/null 2>&1
    fi
}

core_checkout_failed() {
    log_error "Home Assistant Core $HA_VERSION_TAG could not be checked out"
    exit 1
}

# Check if HA Core is already cloned
if [ ! -d "$HA_CORE_DIR" ]; then
    log_info "Cloning Home Assistant Core (sparse checkout, ~5 MB)..."

    # Initialize a sparse checkout; the paths are set below, on every run.
    mkdir -p "$HA_CORE_DIR"
    cd "$HA_CORE_DIR"
    git init >/dev/null 2>&1
    git remote add origin "$HA_CORE_REPO"
    git config core.sparseCheckout true
    echo "/script/" > .git/info/sparse-checkout

    # Fetch the specific version (shallow clone + blobless for minimal size)
    checkout_core_revision || core_checkout_failed
    cd - >/dev/null
    echo ""
else
    # Check if we need to update to match current HA version
    cd "$HA_CORE_DIR"
    if is_commit_sha "$HA_VERSION_TAG"; then
        CURRENT_VERSION=$(git rev-parse HEAD 2>/dev/null || true)
    else
        # An empty repository left by a failed first clone has no HEAD; an empty
        # version differs from the target, so the checkout is retried.
        CURRENT_VERSION=$(git describe --tags --exact-match 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    fi
    cd - >/dev/null

    if [ "$UPDATE_CORE" = true ] || [ "$CURRENT_VERSION" != "$HA_VERSION_TAG" ]; then
        log_info "Updating to version $HA_VERSION_TAG..."
        cd "$HA_CORE_DIR"
        checkout_core_revision >/dev/null || core_checkout_failed
        cd - >/dev/null
    else
        log_info "Using cached version $CURRENT_VERSION"
    fi
fi

# Set the sparse paths on every run, so a cache made by an older version of this
# script gets the paths added since. Home Assistant 2026.11 moved the validator
# core into packages/hassfest, whose setup.py reads Core's pyproject.toml; older
# revisions have no packages/hassfest, which is harmless.
git -C "$HA_CORE_DIR" sparse-checkout set --no-cone \
    /script/ /homeassistant/ /packages/hassfest/ /pyproject.toml \
    /requirements.txt /requirements_all.txt
if [ ! -f "$HA_CORE_DIR/script/hassfest/__main__.py" ]; then
    core_checkout_failed
fi

# Check if we have required dependencies
log_info "Checking dependencies..."
if ! python3 -c "import tqdm" >/dev/null 2>&1; then
    log_info "Installing hassfest helper dependency: tqdm"
    if command -v uv >/dev/null 2>&1; then
        uv pip install tqdm
    else
        python3 -m pip install tqdm
    fi
fi

if ! python3 -c "import voluptuous, awesomeversion, homeassistant.helpers.config_validation" >/dev/null 2>&1; then
    log_error "Missing required dependencies (voluptuous, awesomeversion, homeassistant)"
    log_info "Run: uv sync --group dev"
    exit 1
fi

# Export PYTHONPATH to include HA Core
export PYTHONPATH="$PWD/$HA_CORE_DIR:${PYTHONPATH:-}"

# Build hassfest command
HASSFEST_CMD=()
HASSFEST_PACKAGE="$PWD/$HA_CORE_DIR/packages/hassfest"
# Home Assistant 2026.11 moved the validator core into packages/hassfest, which
# script/hassfest imports; older revisions do not have it.
if [ -f "$HASSFEST_PACKAGE/pyproject.toml" ]; then
    if command -v uv >/dev/null 2>&1; then
        # Layered on the active virtual environment, which provides homeassistant.
        HASSFEST_CMD+=(uv run --no-project --with-editable "$HASSFEST_PACKAGE")
    else
        log_info "Installing Home Assistant's hassfest package"
        python3 -m pip install --quiet --editable "$HASSFEST_PACKAGE"
    fi
fi
HASSFEST_CMD+=(
    python3 -m script.hassfest
    --action validate
    --integration-path "$PWD/$INTEGRATION_PATH"
    # The requirements plugin reads Core's requirement files from here; without
    # it, it reads them from this repository and silently checks nothing.
    --core-path "$PWD/$HA_CORE_DIR"
)

# Add skip-plugins if specified
if [ -n "$SKIP_PLUGINS" ]; then
    HASSFEST_CMD+=(--skip-plugins "$SKIP_PLUGINS")
fi

# Add remaining arguments
HASSFEST_CMD+=("$@")

# Run hassfest
log_info "Running hassfest validation..."
echo ""
if "${HASSFEST_CMD[@]}"; then
    echo ""
    log_success "Hassfest validation passed"
else
    echo ""
    log_error "Hassfest validation failed"
    exit 1
fi
